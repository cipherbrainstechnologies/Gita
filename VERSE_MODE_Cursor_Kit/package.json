{
  "name": "verse-mode-commerce",
  "private": true,
  "version": "0.1.0",
  "description": "Preorder-first fashion commerce engineering scaffold",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx scripts/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:ideas": "tsx scripts/seed-ideas.ts",
    "build:worker": "tsc --noEmit",
    "verify:data": "python3 scripts/verify_seed.py",
    "postinstall": "prisma generate",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "bullmq": "^5.60.0",
    "ioredis": "^5.8.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.17.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4",
    "@eslint/eslintrc": "^3.3.1"
  },
  "prisma": {
    "seed": "tsx scripts/seed-ideas.ts"
  }
}
