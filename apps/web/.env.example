# Local UI preview has no backend purchase functionality by design.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verse_mode?schema=public
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace_with_cryptographically_random_min_32_bytes
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
INTEGRATION_MASTER_KEY=  # 32-byte base64; provide in Railway, never in database
PREVIEW_MODE=true
ENABLE_CHECKOUT=false
# Admin Google account must be independently explicitly whitelisted in DB; no env email-based bypass.

# --- External GPU providers (never run inference on the Railway web service) ---
# Unset => labelled SANDBOX simulations; jobs report NEEDS_CONFIGURATION. Set URLs to your GPU services that implement the HTTP contract in src/lib/providers/graphic/remote.ts.
DIFFUSERS_API_URL=
DIFFUSERS_API_TOKEN=
FASHN_VTON_API_URL=
FASHN_VTON_API_TOKEN=
# Comma-separated hostnames (supports *.example.com) allowed for VAULT-configured AI_RENDER endpoints. Env URL hosts above are auto-allowed. Private IPs are blocked unless NODE_ENV=development.
PROVIDER_ALLOWED_HOSTS=
# Paid generation is blocked unless budget > 0 and per-image cost is set (INR per worker job / per image).
AI_RENDER_BUDGET_INR=0
AI_RENDER_COST_PER_IMAGE_INR=
# Checkpoint id whose model + weights licence has been reviewed (mandatory for remote generation).
AI_RENDER_LICENSED_CHECKPOINT=
# Mounted volume path for generated images (required before paid generation; otherwise outputs would be lost).
ASSET_STORAGE_DIR=
# --- Razorpay (payment initiation + signed webhooks only; blank => NOT CONFIGURED, nothing is simulated) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stage: PREVIEW_MODE unset/true=preview, PREVIEW_MODE=false=waitlist. ENABLE_CHECKOUT=true additionally requires (fail-closed otherwise):
#   Razorpay creds in the encrypted vault (provider RAZORPAY, secret = JSON {"keyId":"...","keySecret":"..."}), >=1 APPROVED PolicyVersion,
#   the legal seller vars below, and a PREORDER product with enabled variants (taxRateBasisPoints set) and supplier-confirmed PreorderCapacity.
LEGAL_SELLER_NAME=
LEGAL_SELLER_GSTIN=
LEGAL_SELLER_ADDRESS=
SHIPPING_FLAT_PAISE=0

# --- Public contact / grievance placeholders (shown on /contact; blank => explicit "pending" placeholder) ---
LEGAL_SELLER_SUPPORT_EMAIL=
LEGAL_SELLER_SUPPORT_PHONE=
LEGAL_SELLER_SUPPORT_HOURS=
LEGAL_SELLER_GRIEVANCE_OFFICER=
LEGAL_SELLER_GRIEVANCE_EMAIL=
LEGAL_SELLER_GRIEVANCE_PHONE=

# --- DEMO mode (NEVER enable in production with real customers) ---
# DEMO_AUTH=true (server) shows demo passwords in the demo banner and marks outbox rows SENT_DEMO (no real email is sent).
# NEXT_PUBLIC_DEMO_MODE=true (build-time, public) shows demo banners and the credentials LoginForm. Credentials provider wiring lives in src/auth.ts.
DEMO_AUTH=true
NEXT_PUBLIC_DEMO_MODE=true
DEMO_CUSTOMER_EMAIL=customer@verse.mode
DEMO_CUSTOMER_PASSWORD=VerseDemo!Cust26
DEMO_ADMIN_EMAIL=admin@verse.mode
DEMO_ADMIN_PASSWORD=VerseDemo!Admin26
DEMO_STAFF_EMAIL=staff@verse.mode
DEMO_STAFF_PASSWORD=VerseDemo!Staff26
# After migrate: npm run db:seed:demo
# DEMO_AUTH (exact string "true") also unlocks three audited admin shortcuts: PREORDER without confirmed capacity (checkout still needs real capacity),
# approving SIMULATION_ONLY designs, and creating a COMPANY pilot store. Never enable with real customers/production data.
