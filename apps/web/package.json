{
  "name": "verse-mode-commerce",
  "private": true,
  "version": "0.1.0",
  "description": "Preorder-first fashion commerce engineering scaffold",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx scripts/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:ideas": "tsx scripts/seed-ideas.ts",
    "db:seed:catalog": "tsx scripts/seed-catalog.ts",
    "db:seed:1000-concepts": "tsx scripts/seed-1000-product-concepts.ts",
    "audit:1000-catalog": "tsx scripts/audit-1000-catalog.ts",
    "db:attach:concept-gallery": "tsx scripts/attach-concept-model-gallery.ts",
    "db:remediate:template-media": "tsx scripts/remediate-template-media.ts",
    "db:register:product-visuals-v2": "tsx scripts/register-product-visuals-v2.ts",
    "audit:visual-diversity": "tsx scripts/audit-visual-diversity.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:v2-content": "tsx scripts/seed-v2-content.ts",
    "verify:v2": "python scripts/verify_v2.py",
    "build:worker": "tsc --noEmit",
    "verify:data": "python3 scripts/verify_seed.py",
    "postinstall": "prisma generate",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.60.0",
    "ioredis": "^5.8.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@railway/cli": "^5.74.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.17.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx scripts/seed-ideas.ts"
  }
}
